#!/bin/bash

# Commit message hook for ticket-first development
echo "🔍 Validating commit message format..."

# Get the commit message
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Check if commit message follows conventional commit format with task ID
if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(TASK-[0-9]{3}\)): .+"; then
    echo "❌ ERROR: Commit message format is invalid"
    echo ""
    echo "📋 Required format: type(TASK-XXX): description"
    echo ""
    echo "📝 Valid types:"
    echo "   feat     - New feature"
    echo "   fix      - Bug fix"
    echo "   docs     - Documentation changes"
    echo "   style    - Code style changes"
    echo "   refactor - Code refactoring"
    echo "   test     - Adding or updating tests"
    echo "   chore    - Maintenance tasks"
    echo "   perf     - Performance improvements"
    echo "   ci       - CI/CD changes"
    echo "   build    - Build system changes"
    echo "   revert   - Reverting changes"
    echo ""
    echo "📝 Examples:"
    echo "   feat(TASK-026): implement photo upload interface"
    echo "   fix(TASK-039): resolve time slider animation bug"
    echo "   docs(TASK-001): update project documentation"
    echo "   chore(TASK-002): set up project structure"
    echo ""
    exit 1
fi

# Extract task ID and type
TASK_ID=$(echo "$COMMIT_MSG" | grep -oE "TASK-[0-9]{3}" | head -1)
COMMIT_TYPE=$(echo "$COMMIT_MSG" | grep -oE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)" | head -1)

echo "✅ Commit message format is valid!"
echo "📋 Type: $COMMIT_TYPE"
echo "🎯 Task: $TASK_ID"
echo "📝 Message: $COMMIT_MSG"
