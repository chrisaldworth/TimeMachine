{
  "name": "rewind-the-map",
  "version": "1.0.0",
  "description": "A web-based platform for uploading historical photos and exploring changes over time",
  "main": "src/backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd src/backend && npm run dev",
    "dev:frontend": "cd src/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd src/backend && npm run build",
    "build:frontend": "cd src/frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd src/backend && npm test",
    "test:frontend": "cd src/frontend && npm test",
    "tasks": "node project-management/task-manager.js",
    "board": "open project-management/kanban-board.html"
  },
  "keywords": [
    "historical-photos",
    "maps",
    "time-slider",
    "react-native",
    "nodejs"
  ],
  "author": "Chris Aldworth",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
