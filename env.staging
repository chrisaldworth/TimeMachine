# Staging Environment Configuration
NODE_ENV=staging
PORT=3000

# Database Configuration
DATABASE_URL=${STAGING_DATABASE_URL}
REDIS_URL=${STAGING_REDIS_URL}

# Authentication
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=7d

# File Storage (Staging - AWS S3)
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=${STAGING_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${STAGING_AWS_SECRET_ACCESS_KEY}
AWS_REGION=${STAGING_AWS_REGION}
AWS_S3_BUCKET=${STAGING_AWS_S3_BUCKET}

# Map Services
MAPBOX_ACCESS_TOKEN=${STAGING_MAPBOX_ACCESS_TOKEN}

# Email Service
SMTP_HOST=${STAGING_SMTP_HOST}
SMTP_PORT=${STAGING_SMTP_PORT}
SMTP_USER=${STAGING_SMTP_USER}
SMTP_PASS=${STAGING_SMTP_PASS}

# External APIs
GOOGLE_MAPS_API_KEY=${STAGING_GOOGLE_MAPS_API_KEY}

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/staging.log

# CORS
CORS_ORIGIN=${STAGING_CORS_ORIGIN}

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
